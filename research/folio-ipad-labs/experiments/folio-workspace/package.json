{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"uv run --frozen uvicorn server.app:app --host 127.0.0.1 --port 8001\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && uv run --frozen pytest -q",
    "postinstall": "node scripts/copy-fonts.mjs",
    "test:e2e": "node scripts/e2e.mjs && node scripts/ai-flow.mjs && node scripts/keyboard.mjs",
    "test:a11y": "node scripts/accessibility.mjs",
    "format": "prettier --write src scripts vite.config.ts"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.30.2",
    "@fontsource/source-sans-3": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.8",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "mathlive": "^0.111.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.51.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
