#!/usr/bin/env python3
"""Start the development LAN worker using this Mac's current addresses."""
import argparse
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys


def command_output(*arguments: str) -> str:
    result = subprocess.run(arguments, capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def main() -> None:
    workspace = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--address", help="Override the automatically detected Wi-Fi IPv4 address")
    parser.add_argument("--connection-file", type=Path,
                        default=workspace.parents[1] / ".reports/ipad-ocr/connection.json")
    args = parser.parse_args()
    address = args.address or command_output("/usr/sbin/ipconfig", "getifaddr", "en0")
    if not address:
        sys.exit("No Wi-Fi IPv4 address found. Connect Wi-Fi or pass --address <Mac-IP>.")
    name = command_output("/usr/sbin/scutil", "--get", "LocalHostName")
    hostname = name + ".local" if name else address
    config = args.connection_file.expanduser().resolve()
    settings = json.loads(config.read_text()) if config.exists() else {}
    settings.update(url=f"http://{hostname}:8002", ip_url=f"http://{address}:8002",
                    token=settings.get("token") or secrets.token_hex(24))
    config.parent.mkdir(parents=True, exist_ok=True)
    temporary = config.with_suffix(".tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w") as handle:
        json.dump(settings, handle, indent=2)
    temporary.chmod(0o600)
    temporary.replace(config)
    config.chmod(0o600)
    print("iPad server:", settings["url"], flush=True)
    print("IP fallback:", settings["ip_url"], flush=True)
    print("Private connection token:", config, flush=True)
    print("Use /health to test the server; requests require the bearer token.", flush=True)
    environment = os.environ.copy()
    environment.update(FOLIO_OCR_LAN="1", FOLIO_OCR_ALLOWED_HOSTS=",".join({address, hostname}),
                       FOLIO_OCR_TOKEN=settings["token"])
    os.chdir(workspace)
    os.execve(str(workspace / "scripts/start-local-ocr"), ["./scripts/start-local-ocr"], environment)


if __name__ == "__main__":
    main()
